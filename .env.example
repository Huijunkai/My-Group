# 服务器配置
PORT=3000

# 数据模式配置（重要！）
# MOCK_MODE=true   - 使用模拟数据模式（开发/测试）
# MOCK_MODE=false  - 使用真实数据模式（生产环境）
MOCK_MODE=true

# 数据库配置（仅在非模拟模式下需要）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=jw_database

# 华为推送服务配置（可选）
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=

# 环境设置
NODE_ENV=development
